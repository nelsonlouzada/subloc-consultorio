# Asaas (sandbox)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Pagamento online (E4): só 'true' liga a cobrança Pix pelo Asaas. Desligado, vale o Pix manual da E2.
ASAAS_ATIVO=false
# Padrão: sandbox. Em produção real: https://api.asaas.com/v3 (só depois dos testes e da conversa com o contador).
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Recibo (opcional): quem aparece como recebedor no PDF. Vazio = a linha não aparece.
RECIBO_EMITENTE_NOME=
RECIBO_EMITENTE_DOC=

# Sentry (vazio = desligado)
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
NEXT_PUBLIC_SENTRY_DSN=

# Pix manual (E2): chave e nome que aparecem no e-mail de reserva aprovada. Vira Asaas na E4.
PIX_MANUAL_CHAVE=
PIX_MANUAL_NOME=

# Opcional: banco dos testes. Sem isto, os testes usam o mesmo servidor com o sufixo _teste (criado sozinho).
