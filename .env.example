BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_REMETENTE=Sala <onboarding@resend.dev>
# Anfitrioes (D7): lidos so por scripts/criar-anfitrioes.ts
ANFITRIAO_1_EMAIL=
ANFITRIAO_1_NOME=
ANFITRIAO_1_SENHA=
ANFITRIAO_2_EMAIL=
ANFITRIAO_2_NOME=
